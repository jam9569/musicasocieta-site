---
import Layout from '../layouts/layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const oggiStr = new Date().toISOString().slice(0, 10);
const newsEntries = await getCollection('news');
const newsHome = newsEntries
  .slice()
  .sort((a, b) => {
    const aFuture = a.data.date >= oggiStr;
    const bFuture = b.data.date >= oggiStr;
    if (aFuture && bFuture) return a.data.date > b.data.date ? 1 : -1;
    if (!aFuture && !bFuture) return a.data.date < b.data.date ? 1 : -1;
    return aFuture ? -1 : 1;
  })
  .slice(0, 3)
  .map(n => ({
    slug: n.id,
    title: n.data.title,
    dateDisplay: new Date(n.data.date).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }),
  }));
---

<Layout title="MusicaSocietà APS">
  <Header />

  <section class="hero">
    <div class="eyebrow"><span class="dot"></span> Rete di scuole di musica</div>
    <h1>Una rete nuova<span class="line2">tra le scuole di musica italiane.</span></h1>
    <p class="sub">Persone, progetti e risorse condivise. Una rete che cresce insieme alle scuole che ne fanno parte.</p>
    <div class="hero-ctas">
      <a href="#cta" class="btn btn-primary">Diventa socio</a>
      <a href="#visione" class="link-arrow">La nostra visione ↓</a>
    </div>
    <div class="hero-fineprint">Associazione di secondo livello · Sede a Bologna</div>
  </section>

  <div class="tagrow">
    <div class="tagrow-inner">
      <div class="lead">Una rete per chi insegna musica.</div>
      <div class="tags">
        <div class="tag">Scuole</div>
        <div class="tag">Docenti</div>
        <div class="tag">Progetti</div>
        <div class="tag">Bandi</div>
      </div>
    </div>
  </div>

  <section class="visione" id="visione">
    <div class="visione-card">
      <div class="visione-eyebrow">La nostra visione</div>
      <p class="visione-quote">«La vita non ha conquistato il pianeta attraverso il combattimento,<br>ma attraverso la creazione di reti.»</p>
      <div class="visione-attr">Lynn Margulis e Dorion Sagan — <em>Microcosmos: Four Billion Years of Microbial Evolution</em>, 1986</div>
    </div>
  </section>

  <section class="features">
    <div class="wrap">
      <div class="features-head">
        <div class="eyebrow"><span class="dot"></span> Perché aderire</div>
        <h2>Fare rete conviene. Davvero.</h2>
      </div>
      <div class="cards2">
        <div class="card card-tea" id="vantaggi">
          <div class="eyebrow">Vantaggi per i soci</div>
          <h3>Le dimensioni portano vantaggi reali.</h3>
          <p>Convenzioni, servizi condivisi e occasioni di formazione pensate per le scuole associate.</p>
          <a href="#cta" class="link-arrow">Scopri i vantaggi →</a>
        </div>
        <div class="card card-yellow" id="progetti-bandi">
          <div class="eyebrow">Progetti e bandi</div>
          <h3>Insieme si arriva più lontano.</h3>
          <p>Bandi regionali, nazionali ed europei: la rete lavora anche per far crescere le opportunità di ogni scuola.</p>
          <a href="#cta" class="link-arrow">Scopri i progetti →</a>
        </div>
      </div>
    </div>
  </section>

  {newsHome.length > 0 && (
    <section class="news-section" id="news">
      <div class="wrap">
        <div class="news-head">
          <div class="eyebrow"><span class="dot"></span> News e novità</div>
          <h2>Cosa succede nella rete.</h2>
        </div>
        <div class="news-grid">
          {newsHome.map(n => (
            <a class="news-card" href={`/news/${n.slug}/`}>
              <span class="news-date">{n.dateDisplay}</span>
              <span class="news-title">{n.title}</span>
              <span class="link-arrow">Leggi di più →</span>
            </a>
          ))}
        </div>
        <div class="news-cta"><a href="/news/" class="link-arrow">Tutte le news →</a></div>
      </div>
    </section>
  )}

  <section class="steps">
    <div class="steps-inner">
      <div>
        <div class="eyebrow"><span class="dot"></span> Come funziona</div>
        <h2>Entrare nella rete.<br>Un passo alla volta.</h2>
      </div>
      <div>
        <div class="step">
          <div class="num">01</div>
          <div><h4>Ci conosciamo.</h4><p>Ci racconti la tua scuola e cosa cerchi in una rete di scuole di musica.</p></div>
        </div>
        <div class="step">
          <div class="num">02</div>
          <div><h4>Verifichiamo i requisiti.</h4><p>Guardiamo insieme allo statuto e alle condizioni per aderire come socio.</p></div>
        </div>
        <div class="step">
          <div class="num">03</div>
          <div><h4>Entri nella rete.</h4><p>Accedi ai vantaggi riservati ai soci e ai progetti in corso.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta" id="cta">
    <div class="cta-inner">
      <div class="cta-left">
        <div class="eyebrow"><span class="dot"></span> Parliamone</div>
        <h2>Facciamo rete insieme.</h2>
        <ul>
          <li>Nessun impegno per il primo contatto</li>
          <li>Ti raccontiamo statuto e vantaggi</li>
          <li>Rispondiamo entro pochi giorni</li>
        </ul>
      </div>
      <div class="form-card">
        <h3>Scrivici.</h3>
        <div class="formsub">Ti ricontattiamo per parlare della tua scuola.</div>
        <label>Nome scuola</label>
        <input type="text" placeholder="Nome della tua scuola">
        <label>Email</label>
        <input type="email" placeholder="nome@scuola.it">
        <label>Messaggio</label>
        <textarea rows="3" placeholder="Raccontaci qualcosa in più"></textarea>
        <button class="btn btn-primary" type="button">Invia richiesta</button>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* hero */
  .hero {
    text-align: center;
    padding: 56px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: clamp(560px, 78vh, 780px);
    background:
      linear-gradient(rgba(255,255,255,0.32), rgba(255,255,255,0.32)),
      linear-gradient(180deg, #ffffff 0%, rgba(255,255,255,0) 18%, rgba(255,255,255,0) 70%, #ffffff 100%),
      radial-gradient(ellipse 62% 72% at 50% 48%, rgba(255,255,255,0.97) 0%, rgba(255,255,255,0.88) 28%, rgba(255,255,255,0.6) 52%, rgba(255,255,255,0.3) 74%, rgba(255,255,255,0.12) 92%),
      url('/assets/hero-orchestra.jpg') center 22% / cover no-repeat;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 5.6vw, 4.1rem);
    line-height: 1.05;
    max-width: 15ch;
    margin: 0 auto;
  }
  .hero h1 .line2 { color: var(--tea); display: block; }
  .hero p.sub {
    max-width: 34rem; margin: 26px auto 0;
    font-size: 1.08rem; color: var(--gray); font-weight: 300;
  }
  .hero-ctas {
    margin-top: 36px; display: flex; align-items: center; justify-content: center; gap: 22px; flex-wrap: wrap;
  }
  .hero-ctas .btn-primary { padding: 14px 28px; font-size: 0.95rem; }
  .hero-fineprint {
    margin-top: 20px; font-size: 0.8rem; color: var(--gray); opacity: 0.8;
  }

  @media (max-width: 900px) {
    .hero {
      height: clamp(520px, 82vh, 680px);
      background:
        linear-gradient(rgba(255,255,255,0.35), rgba(255,255,255,0.35)),
        linear-gradient(180deg, #ffffff 0%, rgba(255,255,255,0) 20%, rgba(255,255,255,0) 68%, #ffffff 100%),
        radial-gradient(ellipse 78% 85% at 50% 45%, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.92) 32%, rgba(255,255,255,0.68) 58%, rgba(255,255,255,0.38) 78%, rgba(255,255,255,0.18) 94%),
        url('/assets/hero-orchestra.jpg') center top / cover no-repeat;
    }
  }
  @media (max-width: 600px) {
    .hero {
      height: auto;
      min-height: 0;
      padding: 220px 24px 44px;
      background:
        linear-gradient(rgba(255,255,255,0.12), rgba(255,255,255,0.12)),
        url('/assets/hero-orchestra.jpg') center top / contain no-repeat;
      background-color: #ffffff;
    }
  }

  /* tag row */
  .tagrow {
    border-top: 1px solid var(--border);
    padding: 26px 32px;
  }
  .tagrow-inner {
    max-width: 1120px; margin: 0 auto;
    display: flex; align-items: center; gap: 34px; flex-wrap: wrap;
    font-family: 'Poppins', sans-serif;
  }
  .tagrow-inner .lead { font-family: 'Lexend', sans-serif; font-weight: 300; color: var(--gray); font-size: 0.92rem; }
  .tagrow-inner .tags { display: contents; }
  .tagrow-inner .tag { font-weight: 600; font-size: 0.95rem; color: var(--ink); }
  @media (max-width: 760px) {
    .tagrow-inner { flex-direction: column; align-items: flex-start; gap: 14px; }
    .tagrow-inner .tags { display: flex; flex-wrap: wrap; gap: 14px 28px; }
  }

  /* visione / quote section */
  section.visione { padding: 140px 32px; background: var(--tea-tint); }
  .visione-card {
    max-width: 780px; margin: 0 auto;
    text-align: center;
  }
  .visione-eyebrow {
    font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.78rem;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--tea-dark);
    margin-bottom: 18px;
  }
  .visione-quote {
    font-family: 'Lexend', sans-serif; font-weight: 400; font-style: italic;
    font-size: 1.35rem; line-height: 1.5; color: var(--ink);
    margin: 0;
  }
  .visione-attr {
    margin-top: 20px; font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.88rem; color: var(--tea-dark);
  }

  /* two-card feature section */
  section.features { padding: 20px 32px 100px; }
  .features-head { text-align: left; max-width: 640px; margin: 0 0 44px; }
  .features-head .eyebrow { color: var(--gray); }
  .features-head h2 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); line-height: 1.1; }
  .cards2 {
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
  }

  /* news teaser */
  section.news-section { padding: 20px 32px 100px; }
  .news-head { max-width: 640px; margin: 0 0 32px; }
  .news-head .eyebrow { color: var(--gray); }
  .news-head h2 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); line-height: 1.1; }
  .news-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .news-card { display: block; background: var(--gray-light); border-radius: 20px; padding: 26px 24px; }
  .news-date { display: block; font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--tea-dark); margin-bottom: 10px; }
  .news-title { display: block; font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.02rem; line-height: 1.3; color: var(--ink); margin-bottom: 12px; }
  .news-card .link-arrow { color: var(--tea-dark); font-size: 0.85rem; }
  .news-cta { margin-top: 30px; text-align: center; }
  @media (max-width: 900px) { .news-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) { .news-grid { grid-template-columns: 1fr; } }

  /* numbered steps */
  section.steps { padding: 90px 32px; background: var(--gray-light); }
  .steps-inner {
    max-width: 1120px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start;
  }
  .steps-inner h2 { font-size: clamp(1.9rem, 3.2vw, 2.5rem); line-height: 1.1; }
  .step {
    display: grid; grid-template-columns: 32px 1fr; gap: 16px;
    padding: 22px 0; border-bottom: 1px solid var(--border);
  }
  .step:last-child { border-bottom: none; }
  .step .num {
    font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 0.78rem; color: var(--ink);
    background: var(--yellow); width: 30px; height: 30px; border-radius: 999px;
    display: flex; align-items: center; justify-content: center;
  }
  .step h4 { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.08rem; margin: 0 0 6px; }
  .step p { margin: 0; color: var(--gray); font-size: 0.92rem; }

  /* cta + form */
  section.cta { padding: 90px 32px; }
  .cta-inner {
    max-width: 1120px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
  }
  .cta-left .eyebrow { color: var(--gray); }
  .cta-left h2 { font-size: clamp(1.9rem, 3.2vw, 2.5rem); line-height: 1.1; margin-bottom: 20px; }
  .cta-left ul { list-style: none; padding: 0; margin: 0 0 22px; }
  .cta-left li { font-size: 0.94rem; color: var(--gray); margin-bottom: 8px; padding-left: 22px; position: relative; }
  .cta-left li::before { content: "✓"; position: absolute; left: 0; color: var(--tea-dark); font-weight: 700; }
  .form-card {
    background: var(--paper); border: 1px solid var(--border); border-radius: 24px; padding: 38px;
  }
  .form-card h3 { font-size: 1.3rem; margin-bottom: 6px; }
  .form-card .formsub { color: var(--gray); font-size: 0.88rem; margin-bottom: 22px; }
  .form-card label { display: block; font-size: 0.82rem; color: var(--gray); margin-bottom: 6px; }
  .form-card input, .form-card textarea {
    width: 100%; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px;
    font-family: 'Lexend', sans-serif; font-size: 0.92rem; margin-bottom: 16px; background: var(--gray-light);
  }
  .form-card button.btn-primary { width: 100%; justify-content: center; padding: 13px; }

  @media (max-width: 760px) {
    .cards2, .steps-inner, .cta-inner { grid-template-columns: 1fr; }
  }
</style>
