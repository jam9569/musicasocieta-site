---
import Layout from '../layouts/layout.astro';
---

<Layout title="MusicaSocietà APS">
  <main
    style="min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem;"
  >
    <svg
      viewBox="53 53 94 94"
      xmlns="http://www.w3.org/2000/svg"
      style="width: 108px; height: 108px; display: block; margin: 0 auto;"
    >
      <circle cx="100" cy="100" r="40" fill="#3d9463"></circle>
      <circle cx="71.72" cy="71.72" r="17" fill="#d9a441" fill-opacity="0.62"></circle>
      <circle cx="128.28" cy="71.72" r="17" fill="#b23a2f" fill-opacity="0.62"></circle>
      <circle cx="71.72" cy="128.28" r="17" fill="#4f7ea1" fill-opacity="0.62"></circle>
      <circle cx="128.28" cy="128.28" r="17" fill="#6b5b4d" fill-opacity="0.62"></circle>
      <text x="100" y="97" text-anchor="middle" font-family="Poppins, sans-serif" font-weight="600" font-size="11" fill="#ffffff">Musica</text>
      <text x="100" y="109" text-anchor="middle" font-family="Lexend, sans-serif" font-weight="300" font-size="11" fill="#ffffff">Società</text>
    </svg>
    <p style="margin: 0.5rem 0 1.25rem; font-style: italic; font-size: 0.82rem; letter-spacing: 0.02em; opacity: 0.6;">
      Music School Network
    </p>
    <h1 style="font-size: clamp(1.8rem, 4vw, 2.8rem); max-width: 40rem; margin: 0 0 1.5rem;">
      Una rete nuova tra le scuole di musica italiane
    </h1>
    <blockquote style="max-width: 32rem; font-style: italic; opacity: 0.85; margin: 0;">
      &laquo;La vita non ha conquistato il pianeta attraverso il combattimento, ma attraverso la creazione di reti.&raquo;
      <footer style="font-style: normal; font-size: 0.9rem; opacity: 0.7; margin-top: 0.5rem;">
        Lynn Margulis e Dorion Sagan
      </footer>
    </blockquote>
    <p style="margin-top: 3rem; opacity: 0.6; font-size: 0.9rem;">
      Sito in costruzione.
    </p>
  </main>
</Layout>
