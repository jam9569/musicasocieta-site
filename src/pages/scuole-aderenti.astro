---
import Layout from '../layouts/layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const scuole = [
  { nome: 'Jam Session APS', citta: 'Bologna', rappresentante: 'Marco Badini', url: 'https://jamsessionaps.it/' },
  { nome: 'Eco della Valle - Piacenza BIMBI IN MUSICA APS', citta: 'Piacenza', rappresentante: 'Graziano Benvenuto Beluffi', url: 'https://www.bimbi-in-musica.it/home' },
  { nome: 'Mondo Musica ETS', citta: 'Parma', rappresentante: 'Daniela Peraino', url: 'https://www.mondomusicaparma.com/' },
  { nome: 'Audioline Music Village APS', citta: 'Casalecchio di Reno (BO)', rappresentante: 'Franco Cacciari', url: 'https://www.audioline-scuoladimusica.it/' },
];
---

<Layout title="Scuole Aderenti — MusicaSocietà APS" description="Le scuole e associazioni fondatrici della rete MusicaSocietà APS.">
  <Header />

  <section class="page-hero">
    <div class="eyebrow"><span class="dot"></span> La rete</div>
    <h1>Scuole <span class="accent">aderenti</span></h1>
    <p class="sub">Le scuole e associazioni che hanno fondato MusicaSocietà APS<br>il 14 febbraio 2026, a Bologna.</p>
  </section>

  <section class="schools">
    <div class="wrap">
      <div class="schools-grid">
        {scuole.map((s) => (
          <div class="school-card">
            <div class="eyebrow">Ente fondatore</div>
            <h3>{s.nome}</h3>
            <p class="meta">{s.citta}</p>
            <p class="rep">Legale rappresentante: {s.rappresentante}</p>
            <a href={s.url} class="link-arrow" target="_blank" rel="noopener">Visita il sito →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="join-cta">
    <div class="wrap join-inner">
      <div>
        <h2>La tua scuola vuole entrare nella rete?</h2>
        <p>Ti raccontiamo come funziona l'adesione e cosa prevede lo statuto. Ci aspettiamo che ogni nuova scuola aderente porti nella rete anche le proprie competenze ed eccellenze, a beneficio di tutti i soci.</p>
      </div>
      <a href="/#cta" class="btn btn-tea">Scrivici</a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  section.schools { padding: 10px 32px 90px; }
  .schools-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
  }
  .school-card {
    border-radius: 24px; padding: 34px 32px; background: var(--tea-tint);
  }
  .school-card .eyebrow { margin-bottom: 12px; }
  .school-card h3 { font-size: 1.25rem; line-height: 1.2; margin-bottom: 12px; }
  .school-card .meta { color: var(--tea-dark); font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.88rem; margin: 0 0 4px; }
  .school-card .rep { color: var(--gray); font-size: 0.9rem; margin: 0 0 14px; }
  .school-card .link-arrow { color: var(--tea-dark); font-size: 0.88rem; }

  section.join-cta { padding: 70px 32px; background: var(--yellow); }
  .join-inner {
    display: flex; align-items: center; justify-content: space-between; gap: 30px; flex-wrap: wrap;
  }
  .join-inner h2 { font-size: 1.5rem; margin-bottom: 8px; }
  .join-inner p { color: var(--gray); margin: 0; }

  @media (max-width: 760px) {
    .schools-grid { grid-template-columns: 1fr; }
    .join-inner { text-align: center; justify-content: center; }
  }
</style>
