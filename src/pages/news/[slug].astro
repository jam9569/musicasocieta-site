---
import Layout from '../../layouts/layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, date, immagine, excerpt } = entry.data;
const dateDisplay = new Date(date).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
const { Content } = await render(entry);
---

<Layout title={`${title} — MusicaSocietà APS`} description={excerpt || title}>
  <Header />

  <section class="article-section">
    <div class="wrap article-wrap">
      <a href="/news/" class="link-arrow back-link">← Tutte le news</a>
      <div class:list={["article-layout", { "has-image": !!immagine }]}>
        <div class="article-text">
          <span class="article-date">{dateDisplay}</span>
          <h1>{title}</h1>
          <div class="article-body">
            <Content />
          </div>
        </div>
        {immagine && (
          <div class="article-image">
            <img src={immagine} alt={title} loading="lazy" />
          </div>
        )}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  section.article-section { padding: 50px 32px 100px; }
  .article-wrap { max-width: 900px; }
  .back-link { margin-bottom: 26px; display: inline-flex; color: var(--tea-dark); }
  .article-layout { display: grid; gap: 32px; }
  .article-date { display: block; font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--tea-dark); margin-bottom: 12px; }
  .article-text h1 { font-size: clamp(1.7rem, 3.6vw, 2.4rem); line-height: 1.15; margin: 0 0 26px; }
  .article-image { border-radius: 22px; overflow: hidden; }
  .article-image img { width: 100%; height: auto; display: block; }
  .article-body { font-family: 'Lexend', sans-serif; font-size: 1rem; line-height: 1.7; color: var(--ink); }
  .article-body p { margin: 0 0 18px; }
  .article-body p:last-child { margin-bottom: 0; }
  @media (min-width: 860px) {
    .article-layout.has-image { grid-template-columns: 1.15fr 1fr; align-items: start; }
    .article-layout.has-image .article-image { position: sticky; top: 90px; }
  }
</style>
